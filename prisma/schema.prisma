generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Creator {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  series Series[]
}

model Episode {
  id          Int       @id @default(autoincrement())
  tmdbId      Int       @unique
  number      Int
  title       String
  resume      String?   @db.LongText
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  seasonId    Int
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  
  views       View[]

  @@index([seasonId])
}

model Movie {
  id                Int                 @id @default(autoincrement())
  tmdbId            Int                 @unique
  title             String
  picture           String?
  resume            String?             @db.LongText
  popularity        Float               @default(0)
  releaseDate       DateTime?
  genres            Json?
  status            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  productioncompany ProductionCompany[]
  views             View[]
  watchlistItems    WatchlistItem[]
}

model ProductionCompany {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  logo          String?
  originCountry String?
  movies        Movie[]
  series        Series[]
}

model Season {
  id             Int       @id @default(autoincrement())
  tmdbId         Int       @unique
  number         Int
  title          String
  picture        String?
  numberEpisodes Int       @default(0)
  resume         String?   @db.LongText
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  seriesId       Int
  series         Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes       Episode[]

  @@index([seriesId])
}

model Series {
  id                Int                 @id @default(autoincrement())
  tmdbId            Int                 @unique
  title             String
  picture           String?
  resume            String?             @db.LongText
  popularity        Float               @default(0)
  releaseDate       DateTime?
  status            String?
  numberEpisodes    Int                 @default(0)
  numberSeasons     Int                 @default(0)
  genres            Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  seasons           Season[]
  creators          Creator[]
  productioncompany ProductionCompany[]
  views             View[]
  watchlistItems    WatchlistItem[]
}

model User {
  id        Int         @id @default(autoincrement())
  email     String      @unique
  name      String
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  views      View[]
  watchlists Watchlist[]
}

model View {
  id       Int      @id @default(autoincrement())
  isSeen   Boolean  @default(false)
  rating   Float?
  emotions Json?
  dateSeen DateTime @default(now())
  
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  movieId   Int?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  seriesId  Int?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([seriesId])
  @@index([episodeId])
}

model Watchlist {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items       WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          Int      @id @default(autoincrement())
  addedAt     DateTime @default(now())
  order       Int      @default(0)
  
  watchlistId Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  
  movieId     Int?
  movie       Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  seriesId    Int?
  series      Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([watchlistId])
  @@index([movieId])
  @@index([seriesId])
}
